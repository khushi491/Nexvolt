# Copy to .env and generate secrets: openssl rand -hex 32 (JWT/OTP), openssl rand -base64 32 (PII key).
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3100,http://localhost:8081
DATABASE_URL=postgresql://nexvolt:nexvolt_local_only@localhost:55432/nexvolt?schema=public
REDIS_URL=redis://localhost:56379
JOBS_ENABLED=true
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl
PII_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl
OTP_PROVIDER=emulator
OTP_HMAC_SECRET=CHANGE_ME_generate_with_openssl
OTP_EMULATOR_FIXED_CODE=123456
LOCAL_DEMO_MODE=true
S3_ENDPOINT=http://localhost:58333
S3_PUBLIC_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=nexvolt-private
S3_ACCESS_KEY_ID=nexvolt_local
S3_SECRET_ACCESS_KEY=nexvolt_local_secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
LOG_LEVEL=info
