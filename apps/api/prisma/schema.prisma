enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  DRIVER_ARRIVED
  CHARGING_STARTED
  CHARGING_CONFIRMATION_NEEDED
  CHARGING_COMPLETED
  PAYMENT_STATUS
  REFUND_STATUS
  PAYOUT_STATUS
  DISPUTE_UPDATE
  SAFETY_ALERT
  VERIFICATION_UPDATE
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +919876543210
  phone                 String     @unique
  name                  String?
  email                 String?
  roles                 Role[]     @default([DRIVER])
  status                UserStatus @default(ACTIVE)
  consentAcceptedAt     DateTime?  @db.Timestamptz(3)
  consentVersion        String?
  notificationPrefs     Json       @default("{}")
  preferredLocale       String     @default("en-IN")
  /// Fictional seed data, clearly flagged in UI.
  isSample              Boolean    @default(false)
  lastLoginAt           DateTime?  @db.Timestamptz(3)
  deletionRequestedAt   DateTime?  @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)

  driverProfile         DriverProfile?
  hostProfile           HostProfile?
  vehicles              Vehicle[]
  refreshTokens         RefreshToken[]
  deviceTokens          DeviceToken[]
  bookings              Booking[]          @relation("DriverBookings")
  reviews               Review[]
  favorites             Favorite[]
  notifications         Notification[]
  tickets               SupportTicket[]    @relation("TicketRequester")
  assignedTickets       SupportTicket[]    @relation("TicketAssignee")
  ticketMessages        SupportMessage[]
  incidents             IncidentReport[]
  disputesRaised        Dispute[]
  documents             VerificationDocument[] @relation("DocumentOwner")
  documentsReviewed     VerificationDocument[] @relation("DocumentReviewer")
  auditLogs             AuditLog[]
  meterReadings         MeterReading[]

  @@index([status])
  @@map("users")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  /// HMAC-SHA256 of the code with a server secret; plaintext codes are never stored.
  codeHash    String?
  provider    String
  /// Provider-side verification id (e.g. Twilio Verify SID) when the provider owns the code.
  providerRef String?
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of the opaque token.
  tokenHash  String    @unique
  /// Rotation family: reuse of a rotated token revokes the whole family.
  familyId   String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?   @db.Uuid
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model DriverProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

model HostProfile {
  id                       String              @id @default(uuid()) @db.Uuid
  userId                   String              @unique @db.Uuid
  displayName              String
  hostType                 HostType
  bio                      String?
  kycStatus                KycStatus           @default(NOT_STARTED)
  payoutAccountStatus      PayoutAccountStatus @default(NOT_STARTED)
  /// Provider linked-account id (e.g. Razorpay Route) once onboarding is genuinely completed.
  payoutProviderAccountId  String?
  attestationAcceptedAt    DateTime?           @db.Timestamptz(3)
  attestationVersion       String?
  verifiedAt               DateTime?           @db.Timestamptz(3)
  verifiedById             String?             @db.Uuid
  suspendedAt              DateTime?           @db.Timestamptz(3)
  suspensionReason         String?
  ratingSum                Int                 @default(0)
  ratingCount              Int                 @default(0)
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)

  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargers                 Charger[]
  ledgerEntries            HostLedgerEntry[]
  payouts                  Payout[]
  documents                VerificationDocument[]

  @@index([kycStatus])
  @@map("host_profiles")
}

// ───────────────────────── Vehicles ─────────────────────────

/// Admin-maintained catalog. Specs must be verified against manufacturer data before use.
model VehicleModel {
  id           String          @id @default(uuid()) @db.Uuid
  manufacturer String
  model        String
  variant      String?
  connectors   ConnectorType[]
  maxAcKw      Decimal         @db.Decimal(6, 2)
  maxDcKw      Decimal?        @db.Decimal(6, 2)
  batteryKwh   Decimal?        @db.Decimal(6, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  vehicles     Vehicle[]

  @@unique([manufacturer, model, variant])
  @@map("vehicle_models")
}

model Vehicle {
  id             String             @id @default(uuid()) @db.Uuid
  ownerId        String             @db.Uuid
  catalogModelId String?            @db.Uuid
  manufacturer   String
  model          String
  nickname       String?
  maxAcKw        Decimal            @db.Decimal(6, 2)
  maxDcKw        Decimal?           @db.Decimal(6, 2)
  isDefault      Boolean            @default(false)
  deletedAt      DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogModel   VehicleModel?      @relation(fields: [catalogModelId], references: [id])
  connectors     VehicleConnector[]
  bookings       Booking[]

  @@index([ownerId])
  @@map("vehicles")
}

model VehicleConnector {
  id            String        @id @default(uuid()) @db.Uuid
  vehicleId     String        @db.Uuid
  connectorType ConnectorType
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, connectorType])
  @@map("vehicle_connectors")
}

// ───────────────────────── Chargers ─────────────────────────

model Charger {
  id                   String             @id @default(uuid()) @db.Uuid
  hostId               String             @db.Uuid
  title                String
  description          String?
  status               ChargerStatus      @default(DRAFT)
  isPublished          Boolean            @default(false)
  pausedAt             DateTime?          @db.Timestamptz(3)
  pauseReason          String?
  currentType          CurrentType
  maxPowerKw           Decimal            @db.Decimal(6, 2)
  chargerMake          String?
  chargerModel         String?
  serialNumber         String?
  meterType            MeterType          @default(NONE)
  /// Set when an admin accepts a meter calibration certificate.
  meterVerifiedAt      DateTime?          @db.Timestamptz(3)
  smartCapable         Boolean            @default(false)
  integrationProvider  String?
  /// Adapter metadata (e.g. OCPP charge point id). Live control requires an enabled, tested adapter.
  integrationMetadata  Json?
  parkingType          ParkingType
  parkingNotes         String?
  wheelchairAccessible Boolean            @default(false)
  /// PRIVATE — returned only to the host, admins, and drivers with an eligible booking.
  accessInstructions   String?
  safetyNotes          String?
  pricingUnit          PricingUnit        @default(PER_HOUR)
  unitPriceMinor       Int
  cancellationPolicy   CancellationPolicy @default(MODERATE)
  approvalMode         ApprovalMode       @default(AUTOMATIC)
  minDurationMinutes   Int                @default(30)
  maxDurationMinutes   Int                @default(240)
  bufferMinutes        Int                @default(15)
  // PRIVATE exact address
  addressLine1         String
  addressLine2         String?
  // Public coarse address
  locality             String
  city                 String
  state                String
  pincode              String
  /// PRIVATE exact point: geography(Point,4326). Read/write only via raw SQL.
  location             Unsupported("geography(Point, 4326)")?
  /// PUBLIC approximate point (200–500 m random offset, generated once).
  publicLocation       Unsupported("geography(Point, 4326)")?
  /// Cached lat/lng of the PUBLIC point for cheap reads.
  publicLat            Decimal            @db.Decimal(9, 6)
  publicLng            Decimal            @db.Decimal(9, 6)
  timezone             String             @default("Asia/Kolkata")
  ratingSum            Int                @default(0)
  ratingCount          Int                @default(0)
  verifiedAt           DateTime?          @db.Timestamptz(3)
  verifiedById         String?            @db.Uuid
  suspendedAt          DateTime?          @db.Timestamptz(3)
  suspensionReason     String?
  isSample             Boolean            @default(false)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  host                 HostProfile               @relation(fields: [hostId], references: [id])
  connectors           ChargerConnector[]
  photos               ChargerPhoto[]
  documents            VerificationDocument[]
  verifications        ChargerVerification[]
  availabilityRules    ChargerAvailabilityRule[]
  exceptions           AvailabilityException[]
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  incidents            IncidentReport[]

  @@index([hostId])
  @@index([status, isPublished])
  @@index([city])
  @@map("chargers")
}

model ChargerConnector {
  id            String        @id @default(uuid()) @db.Uuid
  chargerId     String        @db.Uuid
  connectorType ConnectorType
  powerKw       Decimal       @db.Decimal(6, 2)
  charger       Charger       @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@unique([chargerId, connectorType])
  @@index([connectorType])
  @@map("charger_connectors")
}

model ChargerPhoto {
  id         String       @id @default(uuid()) @db.Uuid
  chargerId  String       @db.Uuid
  storageKey String       @unique
  mimeType   String
  sizeBytes  Int
  status     UploadStatus @default(PENDING_UPLOAD)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  charger    Charger      @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([chargerId, sortOrder])
  @@map("charger_photos")
}

model VerificationDocument {
  id           String         @id @default(uuid()) @db.Uuid
  ownerUserId  String         @db.Uuid
  hostId       String?        @db.Uuid
  chargerId    String?        @db.Uuid
  docType      DocumentType
  fileName     String
  storageKey   String         @unique
  mimeType     String
  sizeBytes    Int
  sha256       String?
  status       DocumentStatus @default(PENDING_UPLOAD)
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?      @db.Timestamptz(3)
  reviewNotes  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  owner        User           @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  reviewer     User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  host         HostProfile?   @relation(fields: [hostId], references: [id])
  charger      Charger?       @relation(fields: [chargerId], references: [id])

  @@index([status, docType])
  @@index([chargerId])
  @@index([hostId])
  @@map("verification_documents")
}

model ChargerVerification {
  id          String               @id @default(uuid()) @db.Uuid
  chargerId   String               @db.Uuid
  status      VerificationDecision @default(PENDING)
  submittedAt DateTime             @default(now()) @db.Timestamptz(3)
  reviewerId  String?              @db.Uuid
  decidedAt   DateTime?            @db.Timestamptz(3)
  checklist   Json?
  notes       String?
  charger     Charger              @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([chargerId, submittedAt])
  @@index([status])
  @@map("charger_verifications")
}

model ChargerAvailabilityRule {
  id          String   @id @default(uuid()) @db.Uuid
  chargerId   String   @db.Uuid
  /// 0 = Sunday (IST)
  dayOfWeek   Int      @db.SmallInt
  /// Minutes from local midnight, [startMinute, endMinute)
  startMinute Int      @db.SmallInt
  endMinute   Int      @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  charger     Charger  @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([chargerId, dayOfWeek])
  @@map("charger_availability_rules")
}

model AvailabilityException {
  id          String        @id @default(uuid()) @db.Uuid
  chargerId   String        @db.Uuid
  /// IST local calendar date
  date        DateTime      @db.Date
  type        ExceptionType
  startMinute Int?          @db.SmallInt
  endMinute   Int?          @db.SmallInt
  reason      String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  charger     Charger       @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([chargerId, date])
  @@map("availability_exceptions")
}

// ───────────────────────── Bookings ─────────────────────────

model Booking {
  id                    String             @id @default(uuid()) @db.Uuid
  /// Human-friendly reference, e.g. NV-7K3Q9P
  code                  String             @unique
  driverId              String             @db.Uuid
  chargerId             String             @db.Uuid
  vehicleId             String             @db.Uuid
  connectorType         ConnectorType
  status                BookingStatus
  startAt               DateTime           @db.Timestamptz(3)
  endAt                 DateTime           @db.Timestamptz(3)
  /// endAt + host buffer at booking time. The exclusion constraint uses [startAt, blockedUntil).
  blockedUntil          DateTime           @db.Timestamptz(3)
  holdExpiresAt         DateTime?          @db.Timestamptz(3)
  approvalMode          ApprovalMode
  cancellationPolicy    CancellationPolicy
  policyAcceptedAt      DateTime           @db.Timestamptz(3)
  // Pricing snapshot (immutable after creation)
  pricingUnit           PricingUnit
  unitPriceMinor        Int
  effectivePowerKw      Decimal            @db.Decimal(6, 2)
  estimatedEnergyWh     Int
  chargingFeeMinor      Int
  serviceFeeMinor       Int
  serviceFeeTaxMinor    Int
  totalMinor            Int
  commissionBps         Int
  currency              String             @default("INR")
  // Final figures (set at completion for kWh pricing)
  finalChargingFeeMinor Int?
  finalTotalMinor       Int?
  idempotencyKey        String
  cancelledAt           DateTime?          @db.Timestamptz(3)
  cancelledByType       ActorType?
  cancelReason          String?
  checkedInAt           DateTime?          @db.Timestamptz(3)
  completedAt           DateTime?          @db.Timestamptz(3)
  settledAt             DateTime?          @db.Timestamptz(3)
  accessRevealedAt      DateTime?          @db.Timestamptz(3)
  reminderSentAt        DateTime?          @db.Timestamptz(3)
  isSample              Boolean            @default(false)
  version               Int                @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  driver                User               @relation("DriverBookings", fields: [driverId], references: [id])
  charger               Charger            @relation(fields: [chargerId], references: [id])
  vehicle               Vehicle            @relation(fields: [vehicleId], references: [id])
  events                BookingStatusEvent[]
  holds                 BookingHold[]
  session               ChargingSession?
  payments              Payment[]
  refunds               Refund[]
  ledgerEntries         HostLedgerEntry[]
  review                Review?
  disputes              Dispute[]
  tickets               SupportTicket[]
  incidents             IncidentReport[]

  @@unique([driverId, idempotencyKey])
  @@index([chargerId, startAt])
  @@index([driverId, startAt])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model BookingStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @db.Uuid
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorType  ActorType
  actorId    String?        @db.Uuid
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_events")
}

/// Audit of each reservation window a booking held (approval, checkout, payment).
model BookingHold {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @db.Uuid
  kind          HoldKind
  expiresAt     DateTime  @db.Timestamptz(3)
  releasedAt    DateTime? @db.Timestamptz(3)
  releaseReason String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt, releasedAt])
  @@map("booking_holds")
}

// ───────────────────────── Charging sessions ─────────────────────────

model ChargingSession {
  id                       String         @id @default(uuid()) @db.Uuid
  bookingId                String         @unique @db.Uuid
  mode                     SessionMode    @default(MANUAL_METER)
  status                   SessionStatus  @default(NOT_STARTED)
  startedAt                DateTime?      @db.Timestamptz(3)
  endedAt                  DateTime?      @db.Timestamptz(3)
  /// Duration and energy are DISTINCT measurements.
  durationMinutes          Int?
  /// Verified energy (Wh). Null until both parties agree or admin reconciles.
  meteredEnergyWh          Int?
  driverStartConfirmedAt   DateTime?      @db.Timestamptz(3)
  hostStartConfirmedAt     DateTime?      @db.Timestamptz(3)
  driverEndConfirmedAt     DateTime?      @db.Timestamptz(3)
  hostEndConfirmedAt       DateTime?      @db.Timestamptz(3)
  completionIdempotencyKey String?        @unique
  assessment               Json?
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
  booking                  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  readings                 MeterReading[]

  @@map("charging_sessions")
}

model MeterReading {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  phase          MeterPhase
  /// Exact kWh as entered (3 dp). Billing uses integer Wh derived from this.
  readingKwh     Decimal         @db.Decimal(12, 3)
  recordedById   String          @db.Uuid
  recordedByRole ActorType
  source         ReadingSource   @default(MANUAL_ENTRY)
  note           String?
  recordedAt     DateTime        @default(now()) @db.Timestamptz(3)
  session        ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recordedBy     User            @relation(fields: [recordedById], references: [id])
  evidence       MeterEvidence[]

  /// One reading per party per phase; corrections go through admin reconciliation.
  @@unique([sessionId, phase, recordedByRole])
  @@map("meter_readings")
}

model MeterEvidence {
  id          String        @id @default(uuid()) @db.Uuid
  readingId   String?       @db.Uuid
  uploaderId  String        @db.Uuid
  bookingId   String        @db.Uuid
  storageKey  String        @unique
  mimeType    String
  sizeBytes   Int
  status      UploadStatus  @default(PENDING_UPLOAD)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  reading     MeterReading? @relation(fields: [readingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("meter_evidence")
}

// ───────────────────────── Payments & ledger ─────────────────────────

model Payment {
  id                  String              @id @default(uuid()) @db.Uuid
  bookingId           String              @db.Uuid
  provider            PaymentProviderName
  isDemo              Boolean             @default(false)
  providerOrderId     String              @unique
  providerPaymentId   String?             @unique
  status              PaymentStatus       @default(CREATED)
  amountMinor         Int
  amountRefundedMinor Int                 @default(0)
  currency            String              @default("INR")
  /// Gateway fee & tax reported by the provider after capture.
  providerFeeMinor    Int?
  providerTaxMinor    Int?
  method              String?
  failureReason       String?
  idempotencyKey      String              @unique
  authorizedAt        DateTime?           @db.Timestamptz(3)
  capturedAt          DateTime?           @db.Timestamptz(3)
  lastReconciledAt    DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  booking             Booking             @relation(fields: [bookingId], references: [id])
  events              PaymentEvent[]
  refunds             Refund[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id                String              @id @default(uuid()) @db.Uuid
  paymentId         String?             @db.Uuid
  provider          PaymentProviderName
  /// Provider event id (x-razorpay-event-id) or a derived key — dedupes webhook retries.
  dedupeKey         String              @unique
  eventType         String
  /// Sanitised payload: no card data is ever stored.
  payload           Json
  signatureVerified Boolean
  processedAt       DateTime?           @db.Timestamptz(3)
  processingError   String?
  receivedAt        DateTime            @default(now()) @db.Timestamptz(3)
  payment           Payment?            @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  bookingId        String       @db.Uuid
  providerRefundId String?      @unique
  amountMinor      Int
  /// Portion attributable to the host charging fee (drives ledger reversal).
  chargingFeePortionMinor Int   @default(0)
  reason           String
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique
  initiatedById    String?      @db.Uuid
  failureReason    String?
  processedAt      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  payment          Payment      @relation(fields: [paymentId], references: [id])
  booking          Booking      @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("refunds")
}

/// Append-only host ledger. Signed amounts: + credits the host, − debits.
model HostLedgerEntry {
  id             String            @id @default(uuid()) @db.Uuid
  hostId         String            @db.Uuid
  bookingId      String?           @db.Uuid
  payoutId       String?           @db.Uuid
  type           LedgerEntryType
  status         LedgerEntryStatus @default(PENDING)
  amountMinor    Int
  currency       String            @default("INR")
  description    String
  /// Deterministic key (e.g. "capture:<paymentId>:gross") — prevents duplicate postings on retries.
  idempotencyKey String            @unique
  eligibleAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  host           HostProfile       @relation(fields: [hostId], references: [id])
  booking        Booking?          @relation(fields: [bookingId], references: [id])
  payout         Payout?           @relation(fields: [payoutId], references: [id])

  @@index([hostId, status])
  @@index([bookingId])
  @@map("host_ledger_entries")
}

model Payout {
  id                String       @id @default(uuid()) @db.Uuid
  hostId            String       @db.Uuid
  amountMinor       Int
  currency          String       @default("INR")
  status            PayoutStatus @default(READY_FOR_PAYOUT)
  method            PayoutMethod @default(MANUAL_BANK_TRANSFER)
  providerPayoutId  String?      @unique
  /// Bank UTR / provider reference confirming the transfer. Required to mark PAID.
  externalReference String?
  failureReason     String?
  createdById       String       @db.Uuid
  confirmedById     String?      @db.Uuid
  confirmedAt       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  host              HostProfile  @relation(fields: [hostId], references: [id])
  entries           HostLedgerEntry[]

  @@index([hostId, status])
  @@map("payouts")
}

// ───────────────────────── Social / support ─────────────────────────

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  bookingId String       @unique @db.Uuid
  authorId  String       @db.Uuid
  chargerId String       @db.Uuid
  rating    Int          @db.SmallInt
  comment   String?
  hostReply String?
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  booking   Booking      @relation(fields: [bookingId], references: [id])
  author    User         @relation(fields: [authorId], references: [id])
  charger   Charger      @relation(fields: [chargerId], references: [id])

  @@index([chargerId, createdAt])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  chargerId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charger   Charger  @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@unique([userId, chargerId])
  @@map("favorites")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?        @db.Timestamptz(3)
  pushStatus  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id          String           @id @default(uuid()) @db.Uuid
  reference   String           @unique
  requesterId String           @db.Uuid
  bookingId   String?          @db.Uuid
  category    TicketCategory
  subject     String
  description String
  status      TicketStatus     @default(OPEN)
  priority    Priority         @default(MEDIUM)
  assigneeId  String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  requester   User             @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  messages    SupportMessage[]

  @@index([status, priority])
  @@index([requesterId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  authorId  String        @db.Uuid
  body      String
  /// Internal staff notes are never returned to the requester.
  internal  Boolean       @default(false)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model IncidentReport {
  id                   String         @id @default(uuid()) @db.Uuid
  reporterId           String         @db.Uuid
  chargerId            String?        @db.Uuid
  bookingId            String?        @db.Uuid
  type                 IncidentType
  severity             Priority
  description          String
  status               IncidentStatus @default(OPEN)
  chargerAutoSuspended Boolean        @default(false)
  resolutionNotes      String?
  resolvedAt           DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  reporter             User           @relation(fields: [reporterId], references: [id])
  charger              Charger?       @relation(fields: [chargerId], references: [id])
  booking              Booking?       @relation(fields: [bookingId], references: [id])

  @@index([status, severity])
  @@map("incident_reports")
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  raisedById      String?       @db.Uuid
  raisedByRole    ActorType
  reason          DisputeReason
  description     String
  status          DisputeStatus @default(OPEN)
  /// Snapshot of meter assessment at the time the dispute was raised.
  assessment      Json?
  resolutionNotes String?
  resolvedById    String?       @db.Uuid
  resolvedAt      DateTime?     @db.Timestamptz(3)
  /// Status the booking was in before it entered DISPUTED.
  previousBookingStatus BookingStatus?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  booking         Booking       @relation(fields: [bookingId], references: [id])
  raisedBy        User?         @relation(fields: [raisedById], references: [id])

  @@index([status])
  @@index([bookingId])
  @@map("disputes")
}

// ───────────────────────── Platform ─────────────────────────

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Append-only. Admin actions record actor, resource, reason and old/new values.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actorRole    String
  action       String
  resourceType String
  resourceId   String?
  reason       String?
  oldValue     Json?
  newValue     Json?
  ip           String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Generic idempotency store for mutating endpoints (Idempotency-Key header).
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String
  userId         String   @db.Uuid
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
