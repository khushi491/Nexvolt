// Nexvolt relational schema.
// Conventions:
//  - UUID primary keys, all timestamps timestamptz in UTC (display in IST at the edge).
//  - Money in integer minor units (paise) — never floats. Energy in integer Wh.
//  - Tables are snake_case plural (@@map); columns are camelCase.
//  - PostGIS geography columns, GiST indexes and the booking exclusion constraint
//    are created in raw SQL migrations because Prisma cannot express them.
//  - Enum values MUST match packages/shared/src/enums.ts (asserted by a test).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, btree_gist, pgcrypto]
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  DRIVER
  HOST
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConnectorType {
  TYPE_2
  CCS2
  CHADEMO
  GBT
  TYPE_1
  BHARAT_AC_001
  BHARAT_DC_001
  DOMESTIC_15A
}

enum CurrentType {
  AC
  DC
}

enum HostType {
  INDIVIDUAL
  APARTMENT_SOCIETY
  BUSINESS
  PARKING_OPERATOR
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum PayoutAccountStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  REJECTED
}

enum ChargerStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MeterType {
  NONE
  CHARGER_DISPLAY
  SEPARATE_SUBMETER
  SMART_OCPP
}

enum PricingUnit {
  PER_HOUR
  PER_KWH
}

enum ApprovalMode {
  AUTOMATIC
  MANUAL
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum ParkingType {
  PRIVATE_DRIVEWAY
  GATED_SOCIETY
  BASEMENT
  OPEN_LOT
  STREET_ADJACENT
  COMMERCIAL_GARAGE
}

enum ExceptionType {
  BLACKOUT
  CUSTOM_HOURS
}

enum DocumentType {
  IDENTITY_PROOF
  PROPERTY_AUTHORIZATION
  SOCIETY_NOC
  ELECTRICAL_SAFETY_CERT
  INSTALLATION_CERT
  METER_CALIBRATION_CERT
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

enum VerificationDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BookingStatus {
  AWAITING_HOST_APPROVAL
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHARGING
  COMPLETED
  SETTLED
  CANCELLED
  EXPIRED
  NO_SHOW
  FAILED
  DISPUTED
}

enum ActorType {
  DRIVER
  HOST
  ADMIN
  SYSTEM
}

enum HoldKind {
  HOST_APPROVAL
  CHECKOUT
  PAYMENT
}

enum SessionMode {
  MANUAL_METER
  SMART_INTEGRATION
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  CONFIRMED
  DISPUTED
  RECONCILED
}

enum MeterPhase {
  START
  END
}

enum ReadingSource {
  MANUAL_ENTRY
  CHARGER_INTEGRATION
  ADMIN_RECONCILIATION
}

enum UploadStatus {
  PENDING_UPLOAD
  UPLOADED
  REJECTED
}

enum PaymentProviderName {
  RAZORPAY
  DEMO
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum LedgerEntryType {
  BOOKING_GROSS
  PLATFORM_COMMISSION
  PAYMENT_FEE
  REFUND_REVERSAL
  COMMISSION_REVERSAL
  ADJUSTMENT
  PAYOUT
}

enum LedgerEntryStatus {
  PENDING
  ELIGIBLE
  IN_PAYOUT
  PAID_OUT
  VOID
}

enum PayoutStatus {
  READY_FOR_PAYOUT
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  MANUAL_BANK_TRANSFER
  PROVIDER_ROUTE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum TicketCategory {
  BOOKING
  PAYMENT
  REFUND
  CHARGER_ISSUE
  ACCOUNT
  SAFETY
  OTHER
