{
  "name": "@nexvolt/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch client for the Nexvolt API, shared by web and mobile.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexvolt/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^3.2.7"
  }
}
